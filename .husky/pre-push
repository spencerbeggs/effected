#!/usr/bin/env sh
# Pre-push hook. Savvy owns any MANAGED SECTION it adds here; custom checks go
# above, below, or between those markers, as in .husky/pre-commit.

ROOT=$(git rev-parse --show-toplevel)

in_ci() { [ -n "$CI" ] || [ -n "$GITHUB_ACTIONS" ]; }

# The generated construct index is committed, so it can be pushed stale — which
# has bitten this repo more than once. The gate reads the pushed range from
# stdin and exits immediately unless that range touches something able to
# invalidate the index, so the common push pays nothing.
#
# Not on pre-commit by design: verifying the tables needs the api-extractor doc
# models, which are gitignored build output, so a cold check costs a build.
# `git push --no-verify` still bypasses it, as with every husky hook.
in_ci || bash "$ROOT/plugin/scripts/check-construct-index.sh" || exit 1

# The committed plugin builds are what the marketplaces install, so a skill,
# agent or hook edit pushed without a rebuild would ship stale content. The
# check takes under a second, so it runs on every push; CI repeats it through
# `pnpm plugin:check` in release.yml's on-build gate.
if ! in_ci && ! (cd "$ROOT/plugin" && pnpm exec pluginfinity build --check >/dev/null 2>&1); then
	echo "plugin: plugin/builds is out of date with its source - push blocked." >&2
	echo "  Rebuild and commit: pnpm build --filter @effected/ai-plugin" >&2
	exit 1
fi
