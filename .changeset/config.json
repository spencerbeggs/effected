{
	"$schema": "https://unpkg.com/@changesets/config@3.1.1/schema.json",
	"access": "restricted",
	"baseBranch": "main",
	"changelog": [
		"@savvy-web/changelog",
		{
			"packages": {
				"@effected/claude-code-plugin": {
					"versionFiles": [
						{
							"glob": "plugins/claude-code/.claude-plugin/plugin.json",
							"paths": ["$.version"]
						}
					]
				},
				"@effected/copilot-plugin": {
					"versionFiles": [
						{
							"glob": "plugins/copilot/plugin.json",
							"paths": ["$.version"]
						}
					]
				}
			},
			"repo": "spencerbeggs/effected"
		}
	],
	"commit": false,
	"ignore": ["docs", "scratchpad"],
	"privatePackages": {
		"tag": true,
		"version": true
	},
	"updateInternalDependencies": "patch"
}
