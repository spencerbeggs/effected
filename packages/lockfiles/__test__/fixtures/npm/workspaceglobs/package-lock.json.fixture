{
  "name": "g-root",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "g-root",
      "version": "0.0.0",
      "workspaces": [
        "./packages/*/",
        "!packages/skip",
        "!!extra/c",
        "tools/**",
        "!tools/deep/**"
      ],
      "dependencies": {
        "hidden": "file:packages/.hidden",
        "skip": "file:packages/skip",
        "t": "file:tools/deep/t"
      }
    },
    "extra/c": {
      "name": "@g/c",
      "version": "1.0.0"
    },
    "node_modules/@g/a": {
      "resolved": "packages/a",
      "link": true
    },
    "node_modules/@g/c": {
      "resolved": "extra/c",
      "link": true
    },
    "node_modules/hidden": {
      "resolved": "packages/.hidden",
      "link": true
    },
    "node_modules/skip": {
      "resolved": "packages/skip",
      "link": true
    },
    "node_modules/t": {
      "resolved": "tools/deep/t",
      "link": true
    },
    "packages/.hidden": {
      "name": "hidden",
      "version": "1.0.0"
    },
    "packages/a": {
      "name": "@g/a",
      "version": "1.0.0"
    },
    "packages/skip": {
      "version": "1.0.0"
    },
    "tools/deep/t": {
      "version": "1.0.0"
    }
  }
}
