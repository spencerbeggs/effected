{
  "name": "r",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "r",
      "version": "0.0.0",
      "workspaces": [
        "../../x",
        "../y",
        "!../**"
      ],
      "dependencies": {
        "x": "file:../../x",
        "y": "file:../y"
      }
    },
    "../../x": {
      "version": "1.0.0"
    },
    "../y": {
      "version": "1.0.0"
    },
    "node_modules/x": {
      "resolved": "../../x",
      "link": true
    },
    "node_modules/y": {
      "resolved": "../y",
      "link": true
    }
  }
}
