    },
    "packages/a": {
      "name": "@wsbump/a",
      "version": "1.0.0",
      "dependencies": {
        "@wsbump/b": "*"
      }
    },
    "packages/b": {
      "name": "@wsbump/b",
      "version": "1.0.1",
      "dependencies": {
        "ms": "^2.0.0"
      }
    }
  }
}
