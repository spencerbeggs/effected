{
  "name": "c-root",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "c-root",
      "version": "0.0.0",
      "workspaces": [
        "packages/**",
        "!packages/b/**",
        "packages/b/a"
      ],
      "dependencies": {
        "bz": "file:packages/b/z"
      }
    },
    "node_modules/ba": {
      "resolved": "packages/b/a",
      "link": true
    },
    "node_modules/bz": {
      "resolved": "packages/b/z",
      "link": true
    },
    "node_modules/x": {
      "resolved": "packages/x",
      "link": true
    },
    "packages/b/a": {
      "name": "ba",
      "version": "1.0.0"
    },
    "packages/b/z": {
      "name": "bz",
      "version": "1.0.0"
    },
    "packages/x": {
      "version": "1.0.0"
    }
  }
}
