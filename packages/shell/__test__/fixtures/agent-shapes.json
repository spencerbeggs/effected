{
	"provenance": "hand-authored from the shapes agents emit in Bash tool calls; see README.md",
	"cases": [
		{
			"name": "chained add and commit",
			"input": "git add -A && git commit -m \"feat: add x\"",
			"expect": {
				"segments": [
					{
						"words": [
							"git",
							"add",
							"-A"
						],
						"operator": "&&"
					},
					{
						"words": [
							"git",
							"commit",
							"-m",
							"feat: add x"
						],
						"operator": null
					}
				],
				"commands": [
					[
						"git",
						"add",
						"-A"
					],
					[
						"git",
						"commit",
						"-m",
						"feat: add x"
					]
				]
			}
		},
		{
			"name": "commit, push and a pipe after it",
			"input": "git add . ; git commit -m 'a; b' && git push | cat",
			"expect": {
				"segments": [
					{
						"words": [
							"git",
							"add",
							"."
						],
						"operator": ";"
					},
					{
						"words": [
							"git",
							"commit",
							"-m",
							"a; b"
						],
						"operator": "&&"
					},
					{
						"words": [
							"git",
							"push"
						],
						"operator": "|"
					},
					{
						"words": [
							"cat"
						],
						"operator": null
					}
				]
			}
		},
		{
			"name": "commit message from a quoted heredoc inside $(…)",
			"input": "git commit -m \"$(cat <<'EOF'\nfeat: add the shell package\n\nIt's done (finally) && tested; see #1204.\nEOF\n)\"",
			"expect": {
				"segments": [
					{
						"words": [
							"git",
							"commit",
							"-m",
							{
								"raw": "\"$(cat <<'EOF'\nfeat: add the shell package\n\nIt's done (finally) && tested; see #1204.\nEOF\n)\"",
								"kinds": [
									"doubleQuoted"
								]
							}
						],
						"operator": null
					}
				],
				"substitutions": [
					{
						"body": "cat <<'EOF'\nfeat: add the shell package\n\nIt's done (finally) && tested; see #1204.\nEOF\n",
						"commands": [
							[
								"cat"
							]
						],
						"heredocs": [
							{
								"heredoc": "EOF",
								"quoted": true,
								"body": "feat: add the shell package\n\nIt's done (finally) && tested; see #1204.\n"
							}
						]
					}
				]
			}
		},
		{
			"name": "commit message from an unquoted heredoc with a nested substitution",
			"input": "git commit -m \"$(cat <<EOF\nfix: $(git rev-parse --short HEAD)\nEOF\n)\"",
			"expect": {
				"segments": [
					{
						"words": [
							"git",
							"commit",
							"-m",
							{
								"raw": "\"$(cat <<EOF\nfix: $(git rev-parse --short HEAD)\nEOF\n)\"",
								"kinds": [
									"doubleQuoted"
								]
							}
						],
						"operator": null
					}
				],
				"substitutions": [
					{
						"body": "cat <<EOF\nfix: $(git rev-parse --short HEAD)\nEOF\n",
						"commands": [
							[
								"cat"
							]
						],
						"heredocs": [
							{
								"heredoc": "EOF",
								"quoted": false,
								"body": "fix: $(git rev-parse --short HEAD)\n"
							}
						]
					}
				]
			}
		},
