		{
			"name": "single quote inside double quotes",
			"source": "test/parse.js",
			"input": "x \"bl'a\"'h'",
			"expect": {
				"segments": [
					{
						"words": [
							"x",
							"bl'ah"
						],
						"operator": null
					}
				]
			}
		},
		{
			"name": "single-quoted backslashes are two tokens",
			"source": "test/parse.js",
			"input": "'\\' '\\'",
			"expect": {
				"segments": [
					{
						"words": [
							"\\",
							"\\"
						],
						"operator": null
					}
				]
			}
		},
		{
			"name": "single-quoted backslash joined with an escaped quote",
			"source": "test/parse.js",
			"input": "'\\'\\''",
			"expect": {
				"segments": [
					{
						"words": [
							{
								"raw": "'\\'\\''",
								"kinds": [
									"singleQuoted",
									"bare",
									"opaque"
								]
							}
						],
						"operator": null
					}
				],
				"diagnostics": [
					"UnterminatedSingleQuote"
				]
			},
			"divergence": "shell-quote reads the last quote as closing; in bash it opens a new, unterminated quote (bash -n reports unexpected EOF)"
		},
		{
			"name": "start-of-line comment",
			"source": "test/parse.js",
			"input": "# abc  def  ghi",
			"expect": {
				"segments": [],
				"comments": [
					" abc  def  ghi"
				]
			}
		},
		{
			"name": "comment after a word",
			"source": "test/parse.js",
			"input": "xyz # abc  def  ghi",
			"expect": {
				"segments": [
					{
						"words": [
							"xyz"
						],
						"operator": null
					}
				],
				"comments": [
					" abc  def  ghi"
				]
			}
		},
		{
			"name": "empty string is preserved",
			"source": "test/parse.js",
			"input": "-x \"\" -y",
			"expect": {
				"segments": [
					{
						"words": [
							"-x",
							"",
							"-y"
						],
						"operator": null
					}
				]
			}
		},
		{
			"name": "control character mid-token (plain form of the custom-escape case)",
			"source": "test/parse.js",
			"input": "2;b",
			"expect": {
				"segments": [
					{
						"words": [
							"2"
						],
						"operator": ";"
					},
					{
						"words": [
							"b"
						],
						"operator": null
					}
				]
			},
			"divergence": "shell-quote's case passes a custom escape character; the plain input is ported instead"
		},
		{
			"name": "close-escape-reopen produces a quote after a quoted backslash",
			"source": "test/parse.js",
			"input": "'\\'\\'",
			"expect": {
				"segments": [
					{
						"words": [
							"\\'"
						],
						"operator": null
					}
				]
			}
		},
		{
			"name": "close-escape-reopen embeds a quote mid-word",
