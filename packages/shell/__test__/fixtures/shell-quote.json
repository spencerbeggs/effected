		{
			"name": "a nested array-index expansion",
			"source": "test/parse.js",
			"input": "level=${levels[$RANDOM%${#levels[@]}]}",
			"expect": {
				"segments": [
					{
						"words": [],
						"operator": null,
						"assignments": [
							[
								"level",
								{
									"raw": "${levels[$RANDOM%${#levels[@]}]}",
									"kinds": [
										"variable"
									]
								}
							]
						]
					}
				]
			},
			"divergence": "shell-quote returns the word level= with the expansion dropped; here the leading assignment is its own record"
		},
