{
	"provenance": "shell-quote 1.10.0 test/{parse,op,comment,set,env}.js, hand-ported; see README.md",
	"cases": [
		{
			"name": "empty string",
			"source": "test/parse.js",
			"input": "",
			"expect": {
				"segments": []
			}
		},
		{
			"name": "empty substitution",
			"source": "test/parse.js",
			"input": "${}",
			"expect": {
				"segments": [
					{
						"words": [
							{
								"raw": "${}",
								"kinds": [
									"variable"
								]
							}
						],
						"operator": null
					}
				],
				"diagnostics": [
					"EmptyParameterExpansion"
				]
			},
			"divergence": "shell-quote throws; this package never fails and records a diagnostic"
		},
		{
			"name": "incomplete substitution",
			"source": "test/parse.js",
			"input": "${",
			"expect": {
				"segments": [
					{
						"words": [
							{
								"raw": "${",
								"kinds": [
									"opaque"
								]
							}
						],
						"operator": null
					}
				],
				"diagnostics": [
					"UnterminatedParameterExpansion"
				]
			},
			"divergence": "shell-quote throws; here the rest of the input is one opaque part"
		},
		{
			"name": "bare, single and double quoted",
			"source": "test/parse.js",
			"input": "a 'b' \"c\"",
			"expect": {
				"segments": [
					{
						"words": [
							"a",
							"b",
							"c"
						],
						"operator": null
					}
				]
			}
		},
		{
			"name": "mixed quoting with escaped quotes",
			"source": "test/parse.js",
			"input": "beep \"boop\" 'foo bar baz' \"it's \\\"so\\\" groovy\"",
			"expect": {
				"segments": [
					{
						"words": [
							"beep",
							"boop",
							"foo bar baz",
							"it's \"so\" groovy"
						],
						"operator": null
					}
				]
			}
		},
		{
			"name": "escaped space",
			"source": "test/parse.js",
			"input": "a b\\ c d",
			"expect": {
				"segments": [
					{
						"words": [
							"a",
							"b c",
							"d"
						],
						"operator": null
					}
				]
			}
		},
		{
			"name": "escaped dollar and backtick",
			"source": "test/parse.js",
			"input": "\\$beep bo\\`op",
			"expect": {
				"segments": [
					{
						"words": [
							"$beep",
							"bo`op"
						],
						"operator": null
					}
				]
			}
		},
		{
			"name": "escaped quotes inside double quotes",
			"source": "test/parse.js",
			"input": "echo \"foo = \\\"foo\\\"\"",
			"expect": {
				"segments": [
					{
						"words": [
							"echo",
							"foo = \"foo\""
						],
						"operator": null
					}
				]
			}
		},
		{
			"name": "a space alone",
			"source": "test/parse.js",
			"input": " ",
			"expect": {
				"segments": []
			}
		},
		{
			"name": "a tab alone",
			"source": "test/parse.js",
			"input": "\t",
			"expect": {
				"segments": []
			}
		},
		{
			"name": "quotes join adjacent text",
			"source": "test/parse.js",
			"input": "a\"b c d\"e",
			"expect": {
				"segments": [
					{
						"words": [
							"ab c de"
						],
						"operator": null
					}
				]
			}
		},
		{
			"name": "escapes and quotes join",
			"source": "test/parse.js",
			"input": "a\\ b\"c d\"\\ e f",
			"expect": {
				"segments": [
					{
						"words": [
							"a bc d e",
							"f"
						],
						"operator": null
					}
				]
			}
		},
		{
			"name": "escapes, double and single quotes join",
			"source": "test/parse.js",
			"input": "a\\ b\"c d\"\\ e'f g' h",
			"expect": {
				"segments": [
					{
						"words": [
							"a bc d ef g",
							"h"
