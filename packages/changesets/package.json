{
	"name": "@effected/changesets",
	"version": "0.5.1",
	"private": true,
	"description": "Changeset files, `.changeset/config.json` and the release plan as Effect schemas and pure functions.",
	"keywords": ["changesets", "release", "semver", "effect", "schema", "effected"],
	"homepage": "https://github.com/spencerbeggs/effected/tree/main/packages/changesets#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/effected.git",
		"directory": "packages/changesets"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./lint": "./src/lint.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "effected package build",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effected/glob": "workspace:^",
		"@effected/semver": "workspace:^",
		"@effected/workspaces": "workspace:^",
		"@effected/yaml": "workspace:^"
	},
	"devDependencies": {
		"@changesets/apply-release-plan": "8.1.1",
		"@changesets/assemble-release-plan": "7.0.0",
		"@changesets/changelog-git": "1.0.0",
		"@changesets/get-release-plan": "5.0.2",
		"@changesets/types": "7.0.0",
		"@effect/platform-node": "catalog:effected",
		"@effect/vitest": "catalog:effected",
		"@effected/markdown": "workspace:*",
		"@effected/markdown-lint": "workspace:*",
		"@effected/memfs": "workspace:*",
		"@types/node": "catalog:effected:build",
		"effect": "catalog:effected",
		"typescript": "catalog:effected:build"
	},
	"peerDependencies": {
		"@effected/markdown": "workspace:^",
		"@effected/markdown-lint": "workspace:^",
		"effect": "catalog:effected:peers"
	},
	"peerDependenciesMeta": {
		"@effected/markdown": {
			"optional": true
		},
		"@effected/markdown-lint": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true
		}
	}
