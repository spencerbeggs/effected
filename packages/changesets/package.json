{
	"name": "@effected/changesets",
	"version": "0.0.0",
	"private": true,
	"description": "Changeset files, `.changeset/config.json` and the release plan as Effect schemas and pure functions.",
	"keywords": ["changesets", "release", "semver", "effect", "schema", "effected"],
	"homepage": "https://github.com/spencerbeggs/effected/tree/main/packages/changesets#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/effected.git",
		"directory": "packages/changesets"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effected/semver": "workspace:^",
		"@effected/workspaces": "workspace:^",
		"@effected/yaml": "workspace:^"
	},
	"devDependencies": {
		"@changesets/get-release-plan": "^5.0.2",
		"@effect/vitest": "catalog:effected",
		"@effected/memfs": "workspace:*",
		"@savvy-web/bundler": "^2.7.4",
		"@types/node": "catalog:build",
		"effect": "catalog:effected",
		"typescript": "catalog:build"
	},
	"peerDependencies": {
		"effect": "catalog:effected:peers"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
