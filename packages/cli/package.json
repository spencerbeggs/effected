{
	"name": "@effected/cli",
	"version": "0.13.0",
	"private": true,
	"description": "The presentation boundary of an effect/cli program: audience-aware output, a document IR and renderers, editor links, failure reports and logging, plus opt-in Ink screens, widgets and a live view",
	"keywords": ["effect", "cli", "logger", "terminal", "ink", "tui"],
	"homepage": "https://github.com/spencerbeggs/effected/tree/main/packages/cli#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/effected.git",
		"directory": "packages/cli"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing.ts",
		"./ui": "./src/ui.ts",
		"./ui/testing": "./src/ui-testing.ts",
		"./ui/testing/serializer": "./src/ui-testing-serializer.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effected/github-commands": "workspace:^"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effect/vitest": "catalog:effect",
		"@effected/config-file": "workspace:*",
		"@effected/env": "workspace:*",
		"@effected/glob": "workspace:*",
		"@effected/jsonc": "workspace:*",
		"@effected/markdown": "workspace:*",
		"@effected/memfs": "workspace:*",
		"@effected/toml": "workspace:*",
		"@effected/walker": "workspace:*",
		"@effected/workspaces": "workspace:*",
		"@effected/yaml": "workspace:*",
		"@savvy-web/bundler": "^2.4.21",
		"@types/node": "catalog:build",
		"@types/react": "catalog:build",
		"effect": "catalog:effect",
		"ink": "7.1.1",
		"react": "catalog:build",
		"string-width": "^8.3.0",
		"typescript": "catalog:build"
	},
	"peerDependencies": {
		"@effected/config-file": "workspace:^",
		"@effected/env": "workspace:^",
		"@effected/glob": "workspace:^",
		"@effected/walker": "workspace:^",
		"@types/react": "^19.2.0",
		"effect": "catalog:effect:peers",
		"ink": "^7.1.1",
		"react": "^19.2.0"
	},
	"peerDependenciesMeta": {
		"@effected/config-file": {
			"optional": true
		},
		"@types/react": {
			"optional": true
		},
		"ink": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
