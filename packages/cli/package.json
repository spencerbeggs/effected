{
	"name": "@effected/cli",
	"version": "0.9.0",
	"private": true,
	"description": "The boundary layer of an effect/unstable/cli program: plain CLI output, failure reporting, and schema-issue rendering",
	"keywords": ["effect", "cli", "logger", "terminal"],
	"homepage": "https://github.com/spencerbeggs/effected/tree/main/packages/cli#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/effected.git",
		"directory": "packages/cli"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effect/vitest": "catalog:effect",
		"@effected/config-file": "workspace:*",
		"@effected/glob": "workspace:*",
		"@effected/jsonc": "workspace:*",
		"@effected/toml": "workspace:*",
		"@effected/walker": "workspace:*",
		"@effected/workspaces": "workspace:*",
		"@effected/yaml": "workspace:*",
		"@savvy-web/bundler": "^2.4.11",
		"@types/node": "catalog:build",
		"effect": "catalog:effect",
		"typescript": "catalog:build"
	},
	"peerDependencies": {
		"@effected/config-file": "workspace:^",
		"effect": "catalog:effect:peers"
	},
	"peerDependenciesMeta": {
		"@effected/config-file": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
