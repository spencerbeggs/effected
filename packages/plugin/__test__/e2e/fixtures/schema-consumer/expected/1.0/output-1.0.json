{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://raw.githubusercontent.com/effected-fixtures/schema-consumer/main/1.0/output-1.0.json",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string",
			"enum": [
				"https://raw.githubusercontent.com/effected-fixtures/schema-consumer/main/1.0/output-1.0.json"
			]
		},
		"name": {
			"type": "string",
			"description": "What produced this output"
		},
		"count": {
			"anyOf": [
				{
					"type": "number"
				},
				{
					"type": "string",
					"enum": [
						"Infinity",
						"-Infinity",
						"NaN"
					]
				}
			]
		},
		"cleanup": {
			"$ref": "#/$defs/Cleanup"
		},
		"logs": {
			"$ref": "#/$defs/Scope"
		}
	},
	"required": [
		"$schema",
		"name"
	],
	"additionalProperties": false,
	"description": "One output file of the schema-consumer fixture",
	"$defs": {
		"Scope": {
			"anyOf": [
				{
					"type": "boolean"
				},
				{
					"type": "object",
					"properties": {
						"preserve": {
							"type": "array",
							"items": {
								"type": "string"
							}
						}
					},
					"required": [
						"preserve"
					],
					"additionalProperties": false
				}
			]
		},
		"Cleanup": {
			"type": "object",
			"properties": {
				"secrets": {
					"$ref": "#/$defs/Scope"
				},
				"variables": {
					"$ref": "#/$defs/Scope"
				}
			},
			"additionalProperties": false
		}
	}
}
