{
	"name": "@effected/plugin",
	"version": "0.5.2",
	"private": true,
	"description": "Install this one package to get the effected command and the effected-mcp server. Depends on @effected/cli and @effected/mcp, and exports defineSchemastore for a schemastore.config.ts.",
	"keywords": ["effect", "effected", "cli", "mcp", "agent"],
	"homepage": "https://github.com/spencerbeggs/effected/tree/main/packages/plugin#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/effected.git",
		"directory": "packages/plugin"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./env": "./public/env.d.ts",
		"./package.json": "./package.json",
		"./tsconfig/*": "./public/tsconfig/*"
	},
	"bin": {
		"effected": "./src/bin/effected.ts",
		"effected-mcp": "./src/bin/effected-mcp.ts"
	},
	"scripts": {
		"build": "effected package build",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effected/cli": "workspace:*",
		"@effected/mcp": "workspace:*",
		"@effected/schemastore": "workspace:*",
		"effect": "catalog:effected"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effected",
		"@effect/vitest": "catalog:effected",
		"@effected/commands": "workspace:*",
		"@effected/kit": "workspace:*",
		"@effected/mcp-kit": "workspace:*",
		"@effected/workspaces": "workspace:*",
		"@types/node": "catalog:effected:build",
		"typescript": "catalog:effected:build"
	},
	"peerDependencies": {
		"@types/node": "catalog:effected:build:peers",
		"typescript": "7.1.0-beta || 7.1.1-rc || >=7.1.0 <8"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true
		}
	}
}
