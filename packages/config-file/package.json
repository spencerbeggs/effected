{
	"name": "@effected/config-file",
	"version": "0.25.0",
	"private": true,
	"description": "Composable config file loading for Effect: JSON, JSONC, YAML and TOML codecs, resolution strategies, and merge behaviors.",
	"keywords": [
		"config",
		"config-file",
		"codec",
		"json",
		"jsonc",
		"yaml",
		"toml",
		"resolver",
		"merge-strategy",
		"effect",
		"schema",
		"effected"
	],
	"homepage": "https://github.com/spencerbeggs/effected/tree/main/packages/config-file#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/effected.git",
		"directory": "packages/config-file"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./jsonc": "./src/jsonc.ts",
		"./toml": "./src/toml.ts",
		"./yaml": "./src/yaml.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "effected package build",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effected/files": "workspace:^"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effected",
		"@effect/vitest": "catalog:effected",
		"@effected/glob": "workspace:*",
		"@effected/jsonc": "workspace:*",
		"@effected/memfs": "workspace:*",
		"@effected/toml": "workspace:*",
		"@effected/walker": "workspace:*",
		"@effected/yaml": "workspace:*",
		"@types/node": "catalog:build",
		"effect": "catalog:effected",
		"typescript": "catalog:build"
	},
	"peerDependencies": {
		"@effected/glob": "workspace:^",
		"@effected/jsonc": "workspace:^",
		"@effected/toml": "workspace:^",
		"@effected/walker": "workspace:^",
		"@effected/yaml": "workspace:^",
		"effect": "catalog:effected:peers"
	},
	"peerDependenciesMeta": {
		"@effected/jsonc": {
			"optional": true
		},
		"@effected/toml": {
			"optional": true
		},
		"@effected/yaml": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true
		}
	}
}
