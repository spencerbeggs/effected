{
	"name": "@effected/pnpm-plugin-effected",
	"version": "0.26.5",
	"private": true,
	"description": "pnpm config dependency for centralized catalog management across the Effected ecosystem.",
	"keywords": ["pnpm", "pnpm-plugin", "config-dependency", "catalog", "monorepo", "effected"],
	"homepage": "https://github.com/spencerbeggs/effected/tree/main/packages/pnpm-plugin-effected#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/effected.git",
		"directory": "packages/pnpm-plugin-effected"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "effected package build",
		"pnpm:export": "cd lib/build && rolldown-pnpm-config export",
		"pnpm:preview": "cd lib/build && rolldown-pnpm-config preview",
		"pnpm:up": "rolldown-pnpm-config upgrade lib/build/pnpm-config.plugin.ts",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "catalog:effected:build",
		"rolldown-pnpm-config": "^2.5.2",
		"typescript": "catalog:effected:build"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true
		}
	}
}
