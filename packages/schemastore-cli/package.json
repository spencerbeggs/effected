{
	"name": "@effected/schemastore-cli",
	"version": "0.13.1",
	"private": true,
	"description": "The schemastore command: build and check SchemaStore-shaped JSON Schema documents from a schemastore.config.ts, with a per-schema published flag and a drift policy.",
	"keywords": ["schemastore", "json-schema", "draft-07", "cli", "effect", "effected"],
	"homepage": "https://github.com/spencerbeggs/effected/tree/main/packages/schemastore-cli#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/effected.git",
		"directory": "packages/schemastore-cli"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"bin": {
		"schemastore": "./src/bin.ts"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effected/cli": "workspace:^",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"jiti": "^2.6.0"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effect",
		"@effected/memfs": "workspace:*",
		"@effected/schemastore": "workspace:*",
		"@savvy-web/bundler": "^2.4.3",
		"@types/node": "catalog:build",
		"effect": "catalog:effect",
		"typescript": "catalog:build"
	},
	"peerDependencies": {
		"@effected/schemastore": "workspace:*",
		"effect": "catalog:effect:peers"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
