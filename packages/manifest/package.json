{
	"name": "@effected/manifest",
	"version": "0.1.0",
	"private": true,
	"description": "The platform-neutral bundle.json manifest of a documentation bundle as a pure schema: the spec-1 shape, its encode and decode boundaries and the authoring-file shape, shared by the bundler that writes it and the doc-site readers that consume it.",
	"keywords": ["bundle", "manifest", "tsdoctor", "api-extractor", "documentation", "schema", "effect", "effected"],
	"homepage": "https://github.com/spencerbeggs/effected/tree/main/packages/manifest#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/effected.git",
		"directory": "packages/manifest"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "effected package build",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effected",
		"@types/node": "catalog:effected:build",
		"effect": "catalog:effected",
		"typescript": "catalog:effected:build"
	},
	"peerDependencies": {
		"effect": "catalog:effected:peers"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true
		}
	}
}
