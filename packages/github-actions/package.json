{
	"name": "@effected/github-actions",
	"version": "0.6.1",
	"private": true,
	"description": "The GitHub Actions runtime: env, inputs, outputs, state, logging, cache, artifacts, blob storage, OIDC and the token bridge.",
	"keywords": ["github-actions", "actions", "runtime", "cache", "oidc", "effect", "effected"],
	"homepage": "https://github.com/spencerbeggs/effected/tree/main/packages/github-actions#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/effected.git",
		"directory": "packages/github-actions"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effected/github": "workspace:^",
		"@effected/glob": "workspace:^"
	},
	"devDependencies": {
		"@azure/storage-blob": "^12.33.0",
		"@effect/platform-node": "catalog:effect",
		"@effect/vitest": "catalog:effect",
		"@effected/markdown": "workspace:*",
		"@effected/npm": "workspace:*",
		"@effected/sbom": "workspace:*",
		"@effected/templates": "workspace:*",
		"@savvy-web/bundler": "^2.1.9",
		"@types/node": "catalog:build",
		"effect": "catalog:effect",
		"typescript": "catalog:build"
	},
	"peerDependencies": {
		"@azure/storage-blob": "^12.33.0",
		"@effect/platform-node": "catalog:effect:peers",
		"@effected/markdown": "workspace:^",
		"@effected/npm": "workspace:^",
		"@effected/sbom": "workspace:^",
		"@effected/templates": "workspace:^",
		"effect": "catalog:effect:peers"
	},
	"peerDependenciesMeta": {
		"@azure/storage-blob": {
			"optional": true
		},
		"@effected/markdown": {
			"optional": true
		},
		"@effected/npm": {
			"optional": true
		},
		"@effected/sbom": {
			"optional": true
		},
		"@effected/templates": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
