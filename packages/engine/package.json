{
	"name": "@effected/engine",
	"version": "0.12.0",
	"private": true,
	"description": "The effected tool's shared logic, consumed by its CLI and MCP front ends",
	"keywords": ["effect", "cli", "mcp", "engine", "effected"],
	"homepage": "https://github.com/spencerbeggs/effected/tree/main/packages/engine#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/effected.git",
		"directory": "packages/engine"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json",
		"./schema": "./src/schema/index.ts"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effected/env": "workspace:^",
		"@effected/glob": "workspace:^",
		"@effected/jsonc": "workspace:^",
		"@effected/kit": "workspace:^",
		"@effected/schemastore": "workspace:*",
		"@effected/source": "workspace:^",
		"@effected/walker": "workspace:^",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"effect": "catalog:effected",
		"jiti": "~2.7.0"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effected",
		"@effect/vitest": "catalog:effected",
		"@effected/memfs": "workspace:*",
		"@savvy-web/bundler": "^2.7.3",
		"@types/node": "catalog:build",
		"typescript": "catalog:build"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
