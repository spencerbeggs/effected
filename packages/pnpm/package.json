{
	"name": "@effected/pnpm",
	"version": "0.1.0",
	"private": true,
	"description": "Everything pnpm owns alone: its settings, versioning block, overrides grammar, workspace file editor and lockfile document.",
	"keywords": ["pnpm", "package-manager", "effect", "schema", "effected"],
	"homepage": "https://github.com/spencerbeggs/effected/tree/main/packages/pnpm#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/effected.git",
		"directory": "packages/pnpm"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json",
		"./settings": "./src/settings.ts"
	},
	"scripts": {
		"build": "effected package build",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effected/glob": "workspace:^",
		"@effected/walker": "workspace:^",
		"@effected/yaml": "workspace:^"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effected",
		"@effected/memfs": "workspace:*",
		"@effected/npm": "workspace:*",
		"@effected/semver": "workspace:*",
		"@types/node": "catalog:effected:build",
		"effect": "catalog:effected",
		"typescript": "catalog:effected:build"
	},
	"peerDependencies": {
		"@effected/npm": "workspace:^",
		"@effected/semver": "workspace:^",
		"effect": "catalog:effected:peers"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true
		}
	}
}
