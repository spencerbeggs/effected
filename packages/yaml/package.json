{
	"name": "@effected/yaml",
	"version": "0.10.0",
	"private": true,
	"description": "Zero-dependency YAML parsing, editing, formatting and linting as Effect schemas.",
	"keywords": ["yaml", "parser", "effect", "schema", "ast", "cst", "editing", "formatting", "linting", "effected"],
	"homepage": "https://github.com/spencerbeggs/effected/tree/main/packages/yaml#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
