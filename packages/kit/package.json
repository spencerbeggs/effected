{
	"name": "@effected/kit",
	"version": "0.13.0",
	"private": true,
	"description": "Platform-free primitives shared by every front end of an Effect v4 tool: distribution identity, remediation, launch context, and transport-neutral process crash guards",
	"keywords": ["effect", "cli", "mcp", "carrier", "distribution", "effected"],
	"homepage": "https://github.com/spencerbeggs/effected/tree/main/packages/kit#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/effected.git",
		"directory": "packages/kit"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./guard": "./src/guard.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effected",
		"@effect/vitest": "catalog:effected",
		"@effected/memfs": "workspace:*",
		"@effected/workspaces": "workspace:*",
		"@savvy-web/bundler": "^2.7.3",
		"@types/node": "catalog:build",
		"effect": "catalog:effected",
		"typescript": "catalog:build"
	},
	"peerDependencies": {
		"effect": "catalog:effected:peers"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
