{
	"name": "@effected/jwt",
	"version": "0.1.0",
	"private": true,
	"description": "JWS, JWT, JWK and JWKS sign and verify over WebCrypto for Effect v4, safe for Workers.",
	"keywords": ["jwt", "jws", "jwk", "jwks", "webcrypto", "workers", "effect", "effected"],
	"homepage": "https://github.com/spencerbeggs/effected/tree/main/packages/jwt#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/effected.git",
		"directory": "packages/jwt"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effect/vitest": "catalog:effect",
		"@savvy-web/bundler": "^2.5.1",
