{
	"name": "@effected/mcp",
	"version": "0.14.0",
	"private": true,
	"description": "The effected-mcp server: the tool's MCP tools on the kit's MCP boundary",
	"keywords": ["effect", "mcp", "model-context-protocol", "effected"],
	"homepage": "https://github.com/spencerbeggs/effected/tree/main/packages/mcp#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/effected.git",
		"directory": "packages/mcp"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./main": "./src/main.ts",
		"./package.json": "./package.json"
	},
	"bin": {
		"effected-mcp": "./src/bin.ts"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effected",
		"@effected/engine": "workspace:*",
		"@effected/glob": "workspace:^",
		"@effected/kit": "workspace:^",
		"@effected/mcp-kit": "workspace:^",
		"@effected/walker": "workspace:^",
		"effect": "catalog:effected"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effected",
		"@effected/memfs": "workspace:*",
		"@effected/schemastore": "workspace:*",
		"@effected/workspaces": "workspace:*",
		"@savvy-web/bundler": "^2.7.4",
		"@types/node": "catalog:build",
		"typescript": "catalog:build"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
