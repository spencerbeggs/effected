{
	"name": "@effected/sbom",
	"version": "0.4.1",
	"private": true,
	"description": "CycloneDX 1.6 SBOM construction, SLSA provenance, NTIA validation and Sigstore signing as typed services.",
	"keywords": ["sbom", "cyclonedx", "sigstore", "slsa", "provenance", "ntia", "effect", "effected"],
	"homepage": "https://github.com/spencerbeggs/effected/tree/main/packages/sbom#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/effected.git",
		"directory": "packages/sbom"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effected/package-json": "workspace:^",
		"@effected/spdx": "workspace:^",
		"@sigstore/bundle": "^5.0.0",
		"@sigstore/sign": "^5.0.0"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effect/vitest": "catalog:effect",
		"@savvy-web/bundler": "^2.1.18",
		"@types/node": "catalog:build",
		"effect": "catalog:effect",
		"typescript": "catalog:build"
	},
	"peerDependencies": {
		"effect": "catalog:effect:peers"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
