{
	"$schema": "https://turborepo.com/schema.v2.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"dependsOn": ["$TURBO_EXTENDS$", "schema:build"]
		},
		"schema:build": {
			"dependsOn": ["$TURBO_EXTENDS$"],
			"outputLogs": "errors-only",
			"outputs": [
				"$TURBO_ROOT$/schemas/*/config.json",
				"$TURBO_ROOT$/schemas/catalog.json",
				"$TURBO_ROOT$/schemas/catalogs/effected.json"
			]
		}
	}
}
