**/.DS_Store
**/node_modules
**/*.tsbuildinfo

# Generated TypeScript declaration files for config files
*.config.d.ts
**/build
**/dist
# construct-index fixtures commit a static api-extractor doc model under a
# dist/ path to mirror real build output; never actually built, so **/dist
# would otherwise swallow it
!plugin/__test__/fixtures/**/dist
!plugin/__test__/fixtures/**/dist/**
**/.rslib
**/.artifacts
**/.turbo
**/.coverage
**/.vitest
**/.cache
coverage/
**/*.asc
pnpm-publish-summary.json
pnpm-release.json
.changeset/status.json

# Environment files (keep .example files committed)
.env
.env.local
.env.development
.env.production
.env.test
.env.workflow
.env.workflow-cli
!.env.example
!.env.*.example

# Claude AI files
.claude/settings.local.json
.claude/plans/
.claude/cache/
docs/superpowers/
.claude/plugins-debug.log
.playwright-mcp
.mcp.json

# Dogfood mailbox — working communication between agent sessions, never committed
.claude/dogfood/

# Docs ignores
website/lib/models/*
website/docs/en/*/api/
website/api-docs-snapshot.db-*
website/api-docs-snapshot.db

# Scratchpad working areas — agent probes are disposable, the shell is committed
scratchpad/probes/
scratchpad/__test__/*.test.ts

# Written by catalog:sync for the workflow to read as a commit message; never committed.
.changeset/catalog-sync.commit.txt
