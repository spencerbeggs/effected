{
	"version": 1,
	"hooks": {
		"SessionStart": [
			{
				"type": "command",
				"bash": "bash \"${PLUGIN_ROOT}/hooks/session-start/orientation.sh\"",
				"timeoutSec": 5,
				"env": {
					"PLUGINFINITY_EVENT": "SessionStart"
				}
			}
		],
		"subagentStart": [
			{
				"type": "command",
				"bash": "bash \"${PLUGIN_ROOT}/hooks/subagent-start/maps.sh\"",
				"timeoutSec": 5,
				"env": {
					"PLUGINFINITY_EVENT": "SubagentStart"
				}
			}
		]
	}
}
