{
	"$schema": "https://turborepo.com/schema.v2.json",
	"agentGuidance": false,
	"globalPassThroughEnv": ["GITHUB_ACTIONS", "CI"],
	"tasks": {
		"build": {
			"cache": true,
			"dependsOn": ["types:check"],
			"env": ["CI", "GITHUB_ACTIONS"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/package.json",
				"$TURBO_ROOT$/pnpm-workspace.yaml",
				"$TURBO_ROOT$/pnpm-lock.yaml",
				"$TURBO_ROOT$/tsconfig.json",
				"$TURBO_ROOT$/packages/bun/src/**",
				"$TURBO_ROOT$/packages/bundler/src/**",
				"$TURBO_ROOT$/packages/changesets/src/**",
				"$TURBO_ROOT$/packages/cli/src/**",
				"$TURBO_ROOT$/packages/cli-kit/src/**",
				"$TURBO_ROOT$/packages/commands/src/**",
				"$TURBO_ROOT$/packages/config-file/src/**",
				"$TURBO_ROOT$/packages/crypto/src/**",
				"$TURBO_ROOT$/packages/engine/src/**",
				"$TURBO_ROOT$/packages/env/src/**",
				"$TURBO_ROOT$/packages/files/src/**",
				"$TURBO_ROOT$/packages/git/src/**",
				"$TURBO_ROOT$/packages/github-commands/src/**",
				"$TURBO_ROOT$/packages/glob/src/**",
				"$TURBO_ROOT$/packages/images/src/**",
				"$TURBO_ROOT$/packages/jsonc/src/**",
				"$TURBO_ROOT$/packages/jsonl/src/**",
				"$TURBO_ROOT$/packages/kit/src/**",
				"$TURBO_ROOT$/packages/lockfiles/src/**",
				"$TURBO_ROOT$/packages/manifest/src/**",
				"$TURBO_ROOT$/packages/markdown/src/**",
				"$TURBO_ROOT$/packages/markdown-lint/src/**",
				"$TURBO_ROOT$/packages/mcp/src/**",
				"$TURBO_ROOT$/packages/mcp-kit/src/**",
				"$TURBO_ROOT$/packages/npm/src/**",
				"$TURBO_ROOT$/packages/package-json/src/**",
				"$TURBO_ROOT$/packages/plugin/src/**",
				"$TURBO_ROOT$/packages/pnpm/src/**",
				"$TURBO_ROOT$/packages/schemastore/src/**",
				"$TURBO_ROOT$/packages/semver/src/**",
				"$TURBO_ROOT$/packages/source/src/**",
				"$TURBO_ROOT$/packages/spdx/src/**",
				"$TURBO_ROOT$/packages/toml/src/**",
				"$TURBO_ROOT$/packages/tsconfig-json/src/**",
				"$TURBO_ROOT$/packages/walker/src/**",
				"$TURBO_ROOT$/packages/workspaces/src/**",
				"$TURBO_ROOT$/packages/yaml/src/**",
				"$TURBO_ROOT$/packages/*/public/**",
				"$TURBO_ROOT$/packages/*/package.json",
				"!$TURBO_ROOT$/packages/testing/**",
				"$TURBO_ROOT$/effected.toml",
				"$TURBO_ROOT$/.config/effected.toml",
				"README.md",
				"LICENSE",
				"package.json",
				"tsconfig.json",
				"effected.toml",
				".config/effected.toml",
				"lib/configs/effected.toml",
				"*.ts",
				"*.mts",
				"*.cts",
				"public/**/*",
				"lib/**/*",
				"src/**/*"
			],
			"outputLogs": "full",
			"outputs": ["dist/**"]
		},
		"schema:build": {
			"cache": false,
			"dependsOn": [],
			"outputLogs": "errors-only"
		},
		"schema:check": {
			"cache": false
		},
		"types:check": {
			"cache": true,
			"dependsOn": ["^types:check"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"*.ts",
				"*.mts",
				"*.cts",
				"src/**/*.ts",
				"src/**/*.tsx",
				"src/**/*.mts",
				"src/**/*.cts",
				"lib/**/*.ts",
				"lib/**/*.tsx",
				"lib/**/*.mts",
				"lib/**/*.cts",
				"__test__/**/*.ts",
				"__test__/**/*.tsx",
				"__test__/**/*.mts",
				"__test__/**/*.cts"
			],
			"outputLogs": "errors-only",
			"outputs": ["dist/.tsbuildinfo.lib"]
		}
	}
}
