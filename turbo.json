{
	"$schema": "https://turborepo.com/schema.v2.json",
	"agentGuidance": false,
	"globalPassThroughEnv": ["GITHUB_ACTIONS", "CI"],
	"tasks": {
		"build": {
			"cache": true,
			"dependsOn": ["types:check"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/package.json",
				"$TURBO_ROOT$/pnpm-workspace.yaml",
				"$TURBO_ROOT$/pnpm-lock.yaml",
				"$TURBO_ROOT$/tsconfig.json",
				"$TURBO_ROOT$/.changeset/**",
				"$TURBO_ROOT$/effected.toml",
				"$TURBO_ROOT$/.config/effected.toml",
				"README.md",
				"LICENSE",
				"package.json",
				"tsconfig.json",
				"effected.toml",
				".config/effected.toml",
				"lib/configs/effected.toml",
				"*.ts",
				"*.mts",
				"*.cts",
				"public/**/*",
				"lib/**/*",
				"src/**/*"
			],
			"outputLogs": "full",
			"outputs": ["dist/**"]
		},
		"types:check": {
			"cache": true,
			"inputs": [
				"$TURBO_DEFAULT$",
				"*.ts",
				"*.mts",
				"*.cts",
				"src/**/*.ts",
				"src/**/*.tsx",
				"src/**/*.mts",
				"src/**/*.cts",
				"lib/**/*.ts",
				"lib/**/*.tsx",
				"lib/**/*.mts",
				"lib/**/*.cts",
				"__test__/**/*.ts",
				"__test__/**/*.tsx",
				"__test__/**/*.mts",
				"__test__/**/*.cts"
			],
			"outputLogs": "errors-only",
			"outputs": ["dist/.tsbuildinfo.lib"]
		}
	}
}
