{
	"name": "effected",
	"version": "0.0.0",
	"private": true,
	"description": "A template repository for developing and deploying Node.js modules from a pnpm monorepo structure.",
	"homepage": "https://github.com/spencerbeggs/effected#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/effected.git"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build --filter=!docs --log-order=grouped --log-prefix=none",
		"catalog:check": "tsx lib/scripts/catalog-sync.ts --check",
		"catalog:sync": "tsx lib/scripts/catalog-sync.ts",
		"changeset:floors": "tsx lib/scripts/breaking-floors.ts",
		"changeset:floors:check": "tsx lib/scripts/breaking-floors.ts --check",
		"ci:build": "CI=\"true\" turbo run build --filter=!docs --log-order=grouped --output-logs=full --log-prefix=none",
		"ci:test": "CI=\"true\" turbo run build --filter='@effected/plugin...' --filter=@effected/pnpm-plugin-effected --filter=@effected/cli-kit --filter=@effected/config-file --filter=@effected/kit --filter=@effected/commands --output-logs=errors-only --log-prefix=none && CI=\"true\" vitest run --passWithNoTests",
		"claude": "claude --plugin-dir plugin/builds/claude",
		"claude:debug": "PLUGINFINITY_DEBUG=1 claude --plugin-dir plugin/builds/claude",
		"copilot": "copilot --plugin-dir plugin/builds/copilot",
		"copilot:debug": "PLUGINFINITY_DEBUG=1 copilot --plugin-dir plugin/builds/copilot",
		"dev": "turbo run dev --filter=docs",
		"lint": "biome check --max-diagnostics=none",
		"lint:fix": "biome check --write --max-diagnostics=none",
		"lint:fix:unsafe": "biome check --write --unsafe --max-diagnostics=none",
		"lint:md": "markdownlint-cli2 --config './lib/configs/.markdownlint-cli2.jsonc'",
		"lint:md:fix": "markdownlint-cli2 --config './lib/configs/.markdownlint-cli2.jsonc' --fix",
		"plugin:check": "pnpm --filter @effected/ai-plugins exec pluginfinity build --check && git diff --exit-code --stat -- plugin/builds && tsx lib/scripts/check-plugin-builds.ts",
		"pnpm:export": "pnpm --filter '@effected/pnpm-plugin-effected' run pnpm:export",
		"pnpm:preview": "pnpm --filter '@effected/pnpm-plugin-effected' run pnpm:preview",
		"pnpm:up": "pnpm --filter '@effected/pnpm-plugin-effected' run pnpm:up",
		"prepare": "husky",
		"preview": "turbo run preview --filter=docs",
		"scratchpad:check": "pnpm --filter scratchpad check",
		"scratchpad:probe": "pnpm --filter scratchpad probe",
		"scratchpad:reset": "pnpm --filter scratchpad reset",
		"test": "vitest run --passWithNoTests",
		"test:bats": "bats --recursive plugin/__test__ < /dev/null",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest --watch",
		"typecheck": "turbo run types:check --log-prefix=none --log-order=grouped",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effected",
		"@effected/changesets": "workspace:*",
		"@effected/plugin": "workspace:*",
		"@effected/workspaces": "workspace:*",
		"@okfit/plugin": "^0.5.34",
		"@savvy-web/silk": "^5.1.1",
		"@vitest-agent/plugin": "^6.0.11",
		"effect": "catalog:effected",
		"tsx": "^4.23.12"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.19.0",
			"onFail": "download"
		},
		"runtime": [
			{
				"name": "node",
				"version": "26.13.0",
				"onFail": "ignore"
			}
		]
	}
}
