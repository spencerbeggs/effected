{
	"extends": ["//"],
	"tasks": {
		"build": {
			"cache": false,
			"dependsOn": [
				"@effected/app#build",
				"@effected/config-file#build",
				"@effected/glob#build",
				"@effected/jsonc#build",
				"@effected/lockfiles#build",
				"@effected/npm#build",
				"@effected/package-json#build",
				"@effected/runtimes#build",
				"@effected/semver#build",
				"@effected/store#build",
				"@effected/toml#build",
				"@effected/walker#build",
				"@effected/workspaces#build",
				"@effected/xdg#build",
				"@effected/yaml#build"
			],
			"outputLogs": "full",
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"dependsOn": [],
			"persistent": true
		},
		"preview": {
			"cache": false,
			"dependsOn": ["build"],
			"persistent": true
		}
	}
}
