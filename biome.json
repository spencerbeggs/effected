{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"extends": ["@savvy-web/silk/biome"],
	"overrides": [
		{
			"includes": ["**/savvy.build.ts"],
			"linter": {
				"rules": {
					"correctness": {
						"noUndeclaredDependencies": "off"
					}
				}
			}
		},
		{
			"assist": {
				"enabled": false
			},
			"formatter": {
				"enabled": false
			},
			"includes": ["plugin/builds/**"],
			"linter": {
				"enabled": false
			}
		}
	],
	"root": true
}
